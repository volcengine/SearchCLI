{
  "Name": "acc-items",
  "Type": "multi_modal",
  "Description": "Acceptance fixture dataset for V2 onboarding",
  "Industry": "e_commerce",
  "Language": "zh",
  "Schema": [
    { "FieldName": "item_id", "FieldType": "string", "BizAttr": "QueryPK", "IsPK": true },
    { "FieldName": "title", "FieldType": "string", "BizAttr": "Title" },
    { "FieldName": "description", "FieldType": "string", "BizAttr": "Description" },
    { "FieldName": "brand", "FieldType": "string", "BizAttr": "Brand" },
    { "FieldName": "tags", "FieldType": "array<string>" },
    { "FieldName": "price", "FieldType": "float" },
    { "FieldName": "image_url", "FieldType": "string", "BizAttr": "ImagePK" }
  ],
  "FieldDescMap": {
    "item_id": "Primary key of the item",
    "title": "Display title shown in search results",
    "description": "Long text describing the item",
    "brand": "Brand name",
    "tags": "Free-form tags",
    "price": "Price in USD",
    "image_url": "Cover image for the item"
  }
}
